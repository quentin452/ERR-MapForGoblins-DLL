# Per-machine environment template — copy to .env.local and set the real paths there.
# .env.local is gitignored and overrides this committed template (see tools/load_env.py:
# real shell env > .env.local > .env; both files are searched in the repo root AND tools/,
# tools/ wins). Empty values are ignored and fall through to tools/config.ini.
#
# Format: plain KEY=VALUE lines; '#' comments; optional 'export ' prefix; surrounding
# quotes stripped. No variable interpolation.

# ── Windows dev box (ERR install the user launches) ────────────────────────────
# ERR mod root (contains mod/, event/, msg/, regulation.bin...). Used by tools/mfg_session.py
# (deploy, boot) and the offline data pipeline.
#ERR_ROOT=D:/DOWNLOAD/ERRv2.2.9.6-541-2-2-9-6-1780861369/ERRv2.2.9.6

# Game install dir (contains eldenring.exe + oo2core_6_win64.dll). Used by tools/config.py
# (param/regulation reads) and tests/test_parse.cpp (KRAK decompression).
#GAME_DIR=E:/SteamLibrary/steamapps/common/ELDEN RING/Game

# ── optional overrides ──────────────────────────────────────────────────────────
# Direct oo2core DLL path (tests/test_parse.cpp). Falls back to <GAME_DIR>/oo2core_6_win64.dll.
#MFG_OO2CORE=E:/SteamLibrary/steamapps/common/ELDEN RING/Game/oo2core_6_win64.dll

# Runtime RPC port (tools/mfg.py). Default 38700.
#MFG_RPC_PORT=38700

# Pipeline profile (tools/build_pipeline.py / config.py). Default "err".
#MFG_PROFILE=err

# Alternative build dir (tools/mfg_rpc.py --build-dir default).
#MFG_BUILD_DIR=build-err

# eldenring.exe override (tools/mfg_session.py). Default <GAME_DIR>/eldenring.exe.
#MFG_EXE=

# modengine binaries (tools/mfg_session.py). Defaults under <ERR_ROOT>/internals/modengine.
#MFG_ME3=
#MFG_ME3_CWD=

# ffdec CLI (asset pipeline). Optional.
#FFDEC_CLI=

# Mod overlay dirs for the non-ERR pipeline profiles (tools/config.py; fall back to
# tools/config.ini [paths]).
#ERR_MOD_DIR=
#CONVERGENCE_MOD_DIR=
#ERTE_MOD_DIR=
#SMITHBOX_DIR=
#DARKSCRIPT_RESOURCES=
