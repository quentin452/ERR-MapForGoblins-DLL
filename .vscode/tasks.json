{
  // MapForGoblins dev tasks (Linux clang-cl + xwin cross-build → Proton). Run via
  // Terminal ▸ Run Task…, or Ctrl+Shift+B for the default build. See
  // docs/memory/tooling/mapforgoblins-linux-build.md for the toolchain setup.
  // Deploy target (ERR_ROOT) comes from .env / .env.local (gitignored) via mfg_session — no hardcoding.
  // Set ERR_ROOT + GAME_DIR in .env.local for your machine.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MFG: Configure (clang-cl xwin)",
      "detail": "First-time / after CMakeLists changes — configure the Ninja build dir.",
      "type": "shell",
      "command": "cmake -B build-linux -G Ninja -DCMAKE_TOOLCHAIN_FILE=clang-cl-xwin.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "MFG: Build DLL (clang)",
      "detail": "ninja build of MapForGoblins.dll (the Windows DLL, cross-built with clang-cl).",
      "type": "shell",
      "command": "ninja -C build-linux MapForGoblins",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "MFG: Deploy DLL (to ERR offline)",
      "detail": "Copy the built DLL + PDB into <ERR_ROOT>/dll/offline (resolved via .env.local; game must be CLOSED; restart to load).",
      "type": "shell",
      "command": "python -c \"import sys,shutil; sys.path.insert(0,'tools'); from mfg_session import DLL_OFFLINE as D; shutil.copy('build-linux/MapForGoblins.dll', D+'/MapForGoblins.dll'); shutil.copy('build-linux/MapForGoblins.pdb', D+'/MapForGoblins.pdb'); print('deployed to', D)\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "MFG: Build + Deploy",
      "detail": "Build then deploy the DLL+PDB in one step.",
      "dependsOrder": "sequence",
      "dependsOn": ["MFG: Build DLL (clang)", "MFG: Deploy DLL (to ERR offline)"],
      "problemMatcher": []
    },
    {
      "label": "MFG: Run all RPC tests (aggregated)",
      "detail": "Boot ER + run the RPC test suite (single-boot tests share ONE boot) + regression scan.",
      "type": "shell",
      "command": "python tools/rpc_tests/run_all.py",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "MFG: Check regressions + refresh STATUS.md",
      "detail": "Scan the test ledger for regressions vs the prior run + regenerate tools/rpc_tests/STATUS.md.",
      "type": "shell",
      "command": "python tools/rpc_tests/check_regress.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "MFG: Run ONE RPC test (pick)",
      "detail": "Pick a single tools/rpc_tests/test_*.py to run (cold-boots ER just for that test) instead of the whole suite.",
      "type": "shell",
      "command": "python tools/rpc_tests/${input:rpcTest}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MFG: Boot ER + RPC repl",
      "detail": "Cold-boot ER (loads a save) + open an interactive RPC shell. Keep this running, then use 'RPC one-shot' or type verbs here (e.g. hf_probe, then open the map).",
      "type": "shell",
      "command": "python tools/mfg.py repl --boot",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "MFG: RPC one-shot (type command)",
      "detail": "Send ONE RPC verb to an ALREADY-RUNNING game (needs ER up — launch it or use 'Boot ER + RPC repl' first). E.g. hf_probe, warp 1042362951, ping.",
      "type": "shell",
      "command": "python tools/mfg.py rpc ${input:rpcCmd}",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "rpcTest",
      "type": "pickString",
      "description": "Which RPC test to run?",
      "options": [
        "test_vmap.py",
        "test_vworld.py",
        "test_warp.py",
        "test_world_bundle.py",
        "test_world_editor.py",
        "test_assets.py",
        "test_move_asset.py",
        "test_spawn_probe.py",
        "test_goods_count.py",
        "test_custom_item.py",
        "test_author_items.py",
        "test_gapc_grant.py",
        "test_sidecar.py"
      ]
    },
    {
      "id": "rpcCmd",
      "type": "promptString",
      "description": "RPC command (e.g. hf_probe, warp 1042362951, ping)",
      "default": "ping"
    }
  ]
}
